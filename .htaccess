<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# No reescribir si la petición es para aab, apks o buscapetweb
RewriteRule ^(buscapetweb|aab|apks)(/.*)?$ - [L]

# Reescribir la raíz a la carpeta buscapetweb
RewriteRule ^$ buscapetweb/ [L]

# Si el archivo o directorio no existe en la raíz, buscarlo dentro de buscapetweb
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ buscapetweb/$1 [L]
</IfModule>

# Prevención de caché agresiva en CDN (Hostinger hcdn) y navegadores
<IfModule mod_headers.c>
  # HTML siempre fresco
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # JS y CSS requieren revalidación
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
